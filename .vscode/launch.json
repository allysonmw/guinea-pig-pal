{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Guinea Pig Pal",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": { "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd" },
      "args": ["."],
      "outputCapture": "std"
    },
    {
      "name": "⚡ Test: fast distraction timers (minutes become seconds)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": { "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd" },
      "args": ["."],
      "env": { "GP_FAST": "1" },
      "outputCapture": "std"
    },
    {
      "name": "🍴 Test: play the eating animation on launch",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": { "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd" },
      "args": ["."],
      "env": { "GP_TEST_EAT": "1" },
      "outputCapture": "std"
    }
  ]
}
